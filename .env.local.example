# MongoDB Atlas (use srv URI from Atlas Connect)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/matchmind

# Optional: standard mongodb:// URI if srv DNS fails on Windows (Atlas → Connect → Drivers → "Standard")
# MONGODB_URI_DIRECT=mongodb://user:pass@host1:27017,host2:27017,host3:27017/matchmind?ssl=true&replicaSet=...&authSource=admin

# MongoDB Atlas MCP Server (optional — when set, lib/mcp.ts routes through MCP transport)
# MCP_SERVER_URL=https://your-mcp-server.example.com

# Google AI / Gemini — required for live AI responses
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Google Cloud Agent Builder / ADK (@google/adk)
GOOGLE_CLOUD_PROJECT=matchmind-498617
AGENT_BUILDER_LOCATION=us-central1
USE_ADK_AGENT=false

# Admin agent — required for /agent/admin score & stat updates
ADMIN_SECRET=choose_a_long_random_secret

# App — subdomain architecture (production)
NEXT_PUBLIC_APP_URL=https://app.matchmind.xyz
NEXT_PUBLIC_AGENT_URL=https://agent.matchmind.xyz
NEXT_PUBLIC_AUTH_URL=https://auth.matchmind.xyz


# Subdomain routing in middleware (set false to use plain localhost:3000 paths)
SUBDOMAIN_ROUTING=true

# Auth.js — required
# Quick setup (interactive): .\scripts\setup-auth-email.ps1  OR  bash scripts/setup-auth-email.sh
# AUTH_SECRET only: .\scripts\generate-auth-secret.ps1  OR  bash scripts/generate-auth-secret.sh
AUTH_SECRET=
AUTH_URL=https://auth.matchmind.xyz

# Share session across subdomains (production only — do not set for plain localhost)
AUTH_COOKIE_DOMAIN=.matchmind.xyz

# Google OAuth — add these if you have Google Cloud OAuth credentials (works alongside email auth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=





# Resend — welcome, password reset, founder welcome, score alerts
RESEND_API_KEY=
EMAIL_FROM=MatchMind <onboarding@resend.dev>
EMAIL_FOUNDER_FROM=Mojeeb from MatchMind <onboarding@resend.dev>
EMAIL_FOUNDER_REPLY_TO=mojeebeth@gmail.com

